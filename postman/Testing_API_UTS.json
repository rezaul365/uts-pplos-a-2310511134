{
  "info": {
    "name": "Testing API UTS Microservices",
    "description": "Koleksi Postman untuk menguji sistem microservices (API Gateway, Auth, Medical, Reservation) melalui Gateway port 3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://localhost:3000/auth/api/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://localhost:3000/auth/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Medical Service",
      "item": [
        {
          "name": "Patients",
          "item": [
            {
              "name": "Get All Patients",
              "request": {
                "method": "GET",
                "url": "http://localhost:3000/api/medical/patients"
              }
            },
            {
              "name": "Get Patient by ID",
              "request": {
                "method": "GET",
                "url": "http://localhost:3000/api/medical/patients/1"
              }
            },
            {
              "name": "Create Patient",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"name\": \"Bambang Pamungkas\",\n    \"nik\": \"3201234567890004\",\n    \"phone\": \"081211223344\",\n    \"address\": \"Jl. Kemerdekaan No. 45, Semarang\"\n}"
                },
                "url": "http://localhost:3000/api/medical/patients"
              }
            },
            {
              "name": "Update Patient",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n    \"name\": \"Bambang Pamungkas (Updated)\",\n    \"nik\": \"3201234567890004\",\n    \"phone\": \"081211223344\",\n    \"address\": \"Jl. Kemerdekaan No. 45, Semarang\"\n}"
                },
                "url": "http://localhost:3000/api/medical/patients/1"
              }
            },
            {
              "name": "Delete Patient",
              "request": {
                "method": "DELETE",
                "url": "http://localhost:3000/api/medical/patients/1"
              }
            }
          ]
        },
